<Window x:Class="Steady.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steady — Settings"
        Width="420" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#4CAF50"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Slim dark scrollbar to match the dark UI -->
        <Style x:Key="DarkScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Background="#5A5A5A" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollHidden" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollHidden}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20">

            <!-- Header -->
            <TextBlock Text="Steady" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Focal Point for Windows" Foreground="#888" Margin="0,0,0,16"/>

            <!-- Sensor section -->
            <TextBlock Text="SENSOR" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="0,4,0,4"/>
            <Border Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Label Content="Sensor source"/>
                    <ComboBox x:Name="TierCombo" SelectionChanged="TierCombo_SelectionChanged">
                        <ComboBoxItem Content="Auto (recommended)" Tag="Auto" IsSelected="True"/>
                        <ComboBoxItem Content="Gyro / Accelerometer (Tier 1)" Tag="Gyro"/>
                        <ComboBoxItem Content="Camera optical flow (Tier 2)" Tag="OpticalFlow"/>
                        <ComboBoxItem Content="Camera head-tracking (Tier 2 alt)" Tag="Camera"/>
                        <ComboBoxItem Content="Microphone noise level (Tier 3)" Tag="Mic"/>
                    </ComboBox>

                    <CheckBox x:Name="CameraEnabledCheck" Content="Enable camera for head tracking"
                              Checked="CameraEnabledCheck_Changed" Unchecked="CameraEnabledCheck_Changed"/>

                    <TextBlock x:Name="ActiveTierLabel" Foreground="#888" FontSize="11"
                               Margin="0,8,0,0" Text="Active sensor: detecting…"/>
                </StackPanel>
            </Border>

            <!-- Appearance section -->
            <TextBlock Text="DOTS APPEARANCE" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="0,8,0,4"/>
            <Border Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Label Content="Dot spacing (lower = denser)"/>
                    <DockPanel>
                        <TextBlock x:Name="DotCountLabel" DockPanel.Dock="Right" Foreground="#AAA" Width="40" TextAlignment="Right"/>
                        <Slider x:Name="DotCountSlider" Minimum="100" Maximum="400" TickFrequency="10"
                                IsSnapToTickEnabled="True" ValueChanged="DotCountSlider_ValueChanged"/>
                    </DockPanel>

                    <Label Content="Dot size"/>
                    <DockPanel>
                        <TextBlock x:Name="DotSizeLabel" DockPanel.Dock="Right" Foreground="#AAA" Width="38" TextAlignment="Right"/>
                        <Slider x:Name="DotSizeSlider" Minimum="4" Maximum="24"
                                ValueChanged="DotSizeSlider_ValueChanged"/>
                    </DockPanel>

                    <Label Content="Opacity"/>
                    <DockPanel>
                        <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Foreground="#AAA" Width="38" TextAlignment="Right"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" SmallChange="0.05"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </DockPanel>

                    <CheckBox x:Name="AdaptiveContrastCheck"
                              Content="Adaptive contrast — auto-adjust dot color to background"
                              Checked="AdaptiveContrastCheck_Changed" Unchecked="AdaptiveContrastCheck_Changed"/>

                    <Label Content="Dot color (used when adaptive contrast is off)"/>
                    <ComboBox x:Name="ColorCombo" SelectionChanged="ColorCombo_SelectionChanged">
                        <ComboBoxItem Content="White"  Tag="#FFFFFF" IsSelected="True"/>
                        <ComboBoxItem Content="Yellow" Tag="#FFD700"/>
                        <ComboBoxItem Content="Cyan"   Tag="#00FFFF"/>
                        <ComboBoxItem Content="Orange" Tag="#FF8C00"/>
                        <ComboBoxItem Content="Green"  Tag="#00FF88"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Motion section -->
            <TextBlock Text="MOTION" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="0,8,0,4"/>
            <Border Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <Label Content="Intensity"/>
                    <DockPanel>
                        <TextBlock x:Name="IntensityLabel" DockPanel.Dock="Right" Foreground="#AAA" Width="38" TextAlignment="Right"/>
                        <Slider x:Name="IntensitySlider" Minimum="0.1" Maximum="3.0" SmallChange="0.1"
                                ValueChanged="IntensitySlider_ValueChanged"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Auto-activation section -->
            <TextBlock Text="AUTO-ACTIVATION" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="0,8,0,4"/>
            <Border Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="AutoActivationCheck" Content="Auto-enable when vehicle motion detected"
                              Checked="AutoActivationCheck_Changed" Unchecked="AutoActivationCheck_Changed"/>

                    <StackPanel x:Name="AutoActivationPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Label Content="Detection sensitivity"/>
                        <DockPanel>
                            <TextBlock x:Name="AutoThresholdLabel" DockPanel.Dock="Right" Foreground="#AAA" Width="42" TextAlignment="Right"/>
                            <Slider x:Name="AutoThresholdSlider" Minimum="0.01" Maximum="0.30"
                                    SmallChange="0.01" LargeChange="0.05"
                                    ValueChanged="AutoThresholdSlider_ValueChanged"/>
                        </DockPanel>
                        <TextBlock Foreground="#666" FontSize="11" TextWrapping="Wrap"
                                   Text="Enables after 3 s of motion above threshold · Disables after 10 s of stillness"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Performance section (v2.0) -->
            <TextBlock Text="PERFORMANCE" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="0,8,0,4"/>
            <Border Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <CheckBox x:Name="BatterySaverCheck"
                              Content="Reduce quality on battery (30 fps, slower sensors)"
                              Checked="BatterySaverCheck_Changed" Unchecked="BatterySaverCheck_Changed"/>

                    <CheckBox x:Name="LowLightCheck" Margin="0,8,0,0"
                              Content="Low-light camera enhancement (CLAHE)"
                              Checked="LowLightCheck_Changed" Unchecked="LowLightCheck_Changed"/>

                    <CheckBox x:Name="AdaptiveThresholdCheck" Margin="0,8,0,0"
                              Content="Adaptive sensitivity — learns noise floor (~15 s calibration)"
                              Checked="AdaptiveThresholdCheck_Changed" Unchecked="AdaptiveThresholdCheck_Changed"/>
                    <TextBlock Foreground="#666" FontSize="11" Margin="20,2,0,0" TextWrapping="Wrap"
                               Text="Overrides the manual detection threshold once calibrated"/>
                </StackPanel>
            </Border>

            <!-- System section -->
            <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="#555" Margin="0,8,0,4"/>
            <Border Background="#2A2A2A" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="StartupCheck" Content="Run at Windows startup"
                              Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
                    <TextBlock Foreground="#666" FontSize="11" Margin="0,6,0,0"
                               Text="Toggle: Ctrl+Alt+M  •  Tray icon double-click"/>
                </StackPanel>
            </Border>

            <!-- Buttons + version -->
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="VersionLabel" DockPanel.Dock="Left" Foreground="#777"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="CloseButton_Click" Background="#444" Margin="0,0,8,0"/>
                    <Button Content="Save" Click="SaveButton_Click"/>
                </StackPanel>
            </DockPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
